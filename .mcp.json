{
  "mcpServers": {
    "twenty-questions": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "twenty-questions-server"
      ],
      "env": {}
    },
    "openalex": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--env-file",
        ".env",
        "openalex-server"
      ],
      "env": {}
    },
    "reading-list": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--env-file",
        ".env",
        "reading-list-server"
      ],
      "env": {}
    }
  }
}